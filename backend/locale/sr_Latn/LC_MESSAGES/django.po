msgstr "Ovaj ID zahteva je već iskorišćen za drugačiji sadržaj."

msgid "Only workouts from this collaboration can be marked as reviewed."
msgstr "Kao pregledan se označava samo trening iz ove saradnje."

msgid "Assign a program"
msgstr "Dodela programa"

msgid "Change the plan"
msgstr "Izmena plana"

msgid "That workout no longer exists."
msgstr "Taj trening više ne postoji."

msgid "The collaboration changed. Reload and try again."
msgstr "Saradnja se promenila. Osveži i pokušaj ponovo."

msgid "That exercise is not available to this client."
msgstr "Ta vežba nije dostupna ovom klijentu."

msgid "Choose a picture."
msgstr "Izaberi sliku."

msgid "The picture is too large (at most 4 MB)."
msgstr "Slika je prevelika (najviše 4 MB)."

msgid "That file is not a picture we can use."
msgstr "Taj fajl nije slika koju možemo da koristimo."

msgid "Write a message or add a picture."
msgstr "Napiši poruku ili dodaj sliku."

msgid "That picture cannot be sent here."
msgstr "Ta slika ne može da se pošalje ovde."

msgid "Too many unsent pictures. Send or wait a day."
msgstr "Previše neposlatih slika. Pošalji ih ili sačekaj dan."

msgid "Sent a picture."
msgstr "Poslao/la je sliku."

msgid "Commented on a workout."
msgstr "Komentar na trening."

msgid "Commented on a week."
msgstr "Komentar na nedelju."

msgid "New message."
msgstr "Nova poruka."

msgid "Your coach updated your plan."
msgstr "Trener je izmenio tvoj plan."

#, python-format
msgid "Your coach added an instruction for %(exercise)s."
msgstr "Trener je dodao uputstvo za vežbu %(exercise)s."

msgid "Shared the weekly review."
msgstr "Poslao/la je nedeljni osvrt."

msgid "You have sent many pictures today. Try again tomorrow."
msgstr "Danas si poslao/la mnogo slika. Pokušaj ponovo sutra."

msgid "Your coach added a new exercise instruction."
msgstr "Trener je dodao novo uputstvo za vežbu."

msgid "Refresh token is required."
msgstr "Token za obnavljanje prijave je obavezan."

msgid "Invalid refresh token."
msgstr "Nevažeći token za obnavljanje prijave."

msgid "Name or aliases are too long for search."
msgstr "Naziv ili alternativni nazivi su predugački za pretragu."

msgid "This food cannot be changed because a recipe using it would become invalid."
msgstr "Ova namirnica ne može da se izmeni jer bi recept koji je koristi postao neispravan."

msgid "Supply all per-100-g snapshot fields or none."
msgstr "Unesi sve sačuvane vrednosti na 100 g ili nijednu."

msgid "A per-100-g snapshot requires a food."
msgstr "Za sačuvane vrednosti na 100 g mora biti izabrana namirnica."

msgid "An existing entry nutritional snapshot cannot be changed."
msgstr "Sačuvane nutritivne vrednosti postojeće stavke ne mogu se menjati."

msgid "Name is too long for search."
msgstr "Naziv je predugačak za pretragu."

#, python-format
msgid "At most %(count)d exercises per workout."
msgstr "Najviše %(count)d vežbi po treningu."

msgid "Invalid workout plan snapshot."
msgstr "Neispravan sačuvani plan treninga."

msgid "The workout plan snapshot is too large."
msgstr "Sačuvani plan treninga je prevelik."

msgid "Invalid history cursor."
msgstr "Neispravan pokazivač istorije."

msgid "Expected a JSON object."
msgstr "Očekuje se JSON objekat."

msgid "This item was already saved. Refresh to see the saved version."
msgstr "Ova stavka je već sačuvana. Osveži stranicu da vidiš sačuvanu verziju."

msgid "At most 20 shared foods every 24 hours."
msgstr "Najviše 20 deljenih namirnica u 24 sata."

msgid "This shared food is used in another user's recipe. Report an error instead."
msgstr "Ova deljena namirnica se koristi u tuđem receptu. Umesto izmene prijavi grešku."

msgid "Closed"
msgstr "Zatvoreno"

msgid "Extra hours"
msgstr "Dodatno radno vreme"

msgid "Requested"
msgstr "Zatražen"

msgid "Confirmed"
msgstr "Potvrđen"

msgid "Declined"
msgstr "Odbijen"

msgid "Cancelled"
msgstr "Otkazan"

msgid "System"
msgstr "Sistem"

msgid "That time is no longer free. Choose another one."
msgstr "Taj termin više nije slobodan. Izaberi drugi."

msgid "This booking has changed. Reload and try again."
msgstr "Termin se u međuvremenu promenio. Osveži i pokušaj ponovo."

msgid "This collaboration has ended."
msgstr "Ova saradnja je završena."

msgid "Choose one of the coach's session types."
msgstr "Izaberi jednu od trenerovih vrsta termina."

msgid "This session type is no longer offered."
msgstr "Ova vrsta termina se više ne nudi."

msgid "Choose a time in the future."
msgstr "Izaberi vreme u budućnosti."

msgid "Choose a time within the next six months."
msgstr "Izaberi vreme u narednih šest meseci."

msgid "Your session is confirmed."
msgstr "Tvoj termin je potvrđen."

msgid "Your session request was declined."
msgstr "Tvoj zahtev za termin je odbijen."

msgid "This session is already over."
msgstr "Ovaj termin je već prošao."

msgid "It is too late to cancel online. Message your coach."
msgstr "Kasno je za otkazivanje u aplikaciji. Javi se treneru porukom."

msgid "Your coach cancelled a session."
msgstr "Trener je otkazao termin."

msgid "Cancelled a session."
msgstr "Otkazao/la je termin."

msgid "Your coach booked a session for you."
msgstr "Trener ti je zakazao termin."

msgid "Booked a session."
msgstr "Zakazao/la je termin."

msgid "Requested a session."
msgstr "Traži termin."

msgid "You have no coach at the moment."
msgstr "Trenutno nemaš trenera."

msgid "At most 20 session types."
msgstr "Najviše 20 vrsta termina."

msgid "The end must be after the start."
msgstr "Kraj mora biti posle početka."

msgid "At most three time ranges per day."
msgstr "Najviše tri vremenska opsega po danu."

msgid "Time ranges of one day must not overlap."
msgstr "Opsezi istog dana ne smeju da se preklapaju."

msgid "At most 31 days at once."
msgstr "Najviše 31 dan odjednom."

msgid "Reminder: your session starts at {time}."
msgstr "Podsetnik: tvoj termin počinje u {time}."

msgid "Reminder: you have a session tomorrow at {time}."
msgstr "Podsetnik: sutra imaš termin u {time}."

msgid "This package has changed. Reload and try again."
msgstr "Paket se u međuvremenu promenio. Osveži i pokušaj ponovo."

msgid "Used sessions must stay between 0 and the package total."
msgstr "Broj iskorišćenih treninga mora biti između 0 i ukupnog broja u paketu."
msgid "This shared food is used in another user's recipe or saved meal. Report an error instead."
msgstr "Ova deljena namirnica se koristi u tuđem receptu ili sačuvanom obroku. Umesto izmene prijavi grešku."

msgid "The proposal has changed. Check the new one."
msgstr "Predlog se promenio. Pogledaj novi."
