# Example only; never commit actual values.
# Set SECRET_KEY and DATABASE_URL as encrypted Vercel environment variables.
DEBUG=False
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_VALUE
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ALLOWED_HOSTS=YOUR-API-PROJECT.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-PROJECT.vercel.app,https://localhost,capacitor://localhost
CSRF_TRUSTED_ORIGINS=https://YOUR-API-PROJECT.vercel.app

# Vercel Cron calls /api/internal/cleanup-auth-throttle/ with Bearer CRON_SECRET.
# Generate a random non-public value and set it as an encrypted Vercel env var.
CRON_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE

# Optional: leave account recovery disabled until a real email provider is configured.
# Never put SMTP usernames or passwords in this committed example.
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=YOUR_SMTP_USERNAME
# EMAIL_HOST_PASSWORD=SET_AS_ENCRYPTED_VERCEL_VARIABLE
# DEFAULT_FROM_EMAIL=noreply@your-domain.example
