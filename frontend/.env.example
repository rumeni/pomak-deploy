# Web uses /api via Vite's local proxy; native APKs need an absolute API URL.
# For Android on the same LAN use VITE_API_URL=http://192.168.1.10:8001/api (CAP_DEV=1).
VITE_API_URL=/api

# Public widget key only (never the secret). Set on pomak-web when backend recovery is enabled.
# VITE_TURNSTILE_SITE_KEY=your-public-turnstile-sitekey
