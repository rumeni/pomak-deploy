{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "QA_CONFIG_PROBE_UNKNOWN_FIELD": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pomak-pr13-staging-api.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
